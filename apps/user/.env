# Cấu hình mặc định (không chứa bí mật). Ghi đè cục bộ trong .env.local.

# Tiền tố API mà client gọi tới.
VITE_API_BASE_URL=/api

# true = dùng mock server (MSW) chạy trong trình duyệt, không cần backend.
VITE_USE_MOCK=true

# Backend thật cho dev proxy (chỉ dùng khi VITE_USE_MOCK=false).
API_PROXY_TARGET=http://localhost:8080
